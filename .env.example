# Copiá este archivo a .env.local y llenalo con las credenciales del proyecto Supabase.
# .env.local está en .gitignore — nunca se commitea.

# ── Frontend (Vite expone las que empiezan con VITE_) ──
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Edge functions (se pasan con `supabase secrets set` al deployar) ──
# En dev local (supabase start), Supabase inyecta automáticamente SUPABASE_URL,
# SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY. Solo necesitás setear:
RL_SALT=cambiame-a-algo-random-largo-al-menos-32-chars
CRON_SECRET=otro-random-para-que-solo-el-cron-llame-a-caducar

# ── Solo si vas a aplicar migraciones remotas desde este entorno ──
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
# SUPABASE_DB_PASSWORD=      # solo si usás supabase db push directo
